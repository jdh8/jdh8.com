---
layout: default
---
<header>
	<h1>標籤：{{ page.title }}</h1>
	{{ site.data.tags[page.title] | markdownify }}
</header>
{% include series.liquid posts=page.posts %}
{% if page.posts.size > site.paginate %}
	<template id="loader">
		<button type="button" id="load">較舊貼文</button>
	</template>
	<script type="module">
		import reveal from "{{ site.baseurl }}/reveal.js";
		reveal([...document.querySelectorAll("article.post")], {{ site.paginate }});
	</script>
{% endif %}
